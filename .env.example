# Public WebSocket URL for the now-playing room.
# Leave unset and the NowPlaying card simply never renders.
#
# local:      ws://127.0.0.1:8787/ws
# production: wss://now-playing.<your-subdomain>.workers.dev/ws
PUBLIC_NOW_PLAYING_WS=

# Contact form Worker endpoint (contact/worker).
# Leave unset and the contact form disables its send button, leaving the
# channel list beside it as the way to reach you.
#
# local:      http://127.0.0.1:8788/contact
# production: https://contact-form.<your-subdomain>.workers.dev/contact
PUBLIC_CONTACT_ENDPOINT=
